# Get a key at https://www.assemblyai.com/dashboard/api-keys
# Copy this file to `.env` (which is gitignored) and paste your key in.
ASSEMBLY_AI_KEY=your_key_here

# Optional limits for a public demo, counted in replies (a full call is about 10). 0 turns a limit off.
# DEMO_IP_LIMIT=40
# DEMO_DAILY_LIMIT=500
